					<appliesForce>true</appliesForce>
					<!--Name of the coordinate to which this force is applied.-->
					<coordinate>l_eye_sup_inf</coordinate>
					<!--Spring stiffness.-->
					<stiffness>0.002225</stiffness>
					<!--Coordinate value at which spring produces no force.-->
